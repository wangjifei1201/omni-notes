/* app.wxss - Omni-Notes 浅色简洁风格全局样式 */

/* ========== 基础设置 ========== */
page {
  /* 浅色主题背景色 */
  --bg-primary: #f8f9fc;
  --bg-secondary: #ffffff;
  --bg-card: #ffffff;
  --bg-card-hover: #f5f6fa;

  /* 边框色 */
  --border-color: rgba(0, 0, 0, 0.08);
  --border-color-hover: rgba(124, 58, 237, 0.3);

  /* 主色调 - 紫色渐变 */
  --primary: #7c3aed;
  --primary-light: #a855f7;
  --primary-dark: #5b21b6;

  /* 强调色 - 科技蓝 */
  --accent: #00d4ff;
  --accent-light: #00e5ff;

  /* 文字色 */
  --text-primary: #1a1a2e;
  --text-secondary: #6b6b7e;
  --text-tertiary: #8b8b9e;
  --text-hint: #a0a0b0;

  /* 功能色 */
  --success: #22c55e;
  --warning: #f59e0b;
  --error: #ef4444;

  /* 阴影 - 柔和的阴影效果 */
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.1);
  --shadow-glow: 0 4px 20px rgba(124, 58, 237, 0.15);

  /* 玻璃态效果 */
  --glass-bg: rgba(255, 255, 255, 0.95);
  --glass-border: rgba(255, 255, 255, 0.8);
  --glass-blur: blur(20px);

  /* TabBar 颜色 */
  --tab-bar-bg: #ffffff;
  --tab-bar-color: #8b8b9e;
  --tab-bar-active: #7c3aed;

  /* 字体 */
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  background: var(--bg-primary);
  color: var(--text-primary);
  font-size: 16px;
  line-height: 1.5;
}

/* ========== 全局背景效果 ========== */
page::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #f8f9fc;
  pointer-events: none;
  z-index: -1;
}

/* ========== 容器 ========== */
.container {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 100vh;
}

/* ========== 按钮重置 ========== */
button {
  background: initial;
  border: none;
  padding: 0;
  margin: 0;
  font-family: inherit;
  font-size: inherit;
  color: inherit;
  border-radius: 0;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

/* 文本选择 */
text {
  user-select: none;
}

/* 输入框基础样式 */
input, textarea {
  font-family: inherit;
  outline: none;
  -webkit-appearance: none;
  background: transparent;
  color: var(--text-primary);
}

/* ========== 滚动条美化 ========== */
::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(124, 58, 237, 0.4);
  border-radius: 2px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(124, 58, 237, 0.6);
}

/* ========== 通用动画 ========== */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* 霓虹呼吸动画 */
@keyframes neonPulse {
  0%, 100% {
    box-shadow: 0 0 5px rgba(168, 85, 247, 0.5),
                0 0 10px rgba(168, 85, 247, 0.3),
                0 0 15px rgba(168, 85, 247, 0.2);
  }
  50% {
    box-shadow: 0 0 10px rgba(168, 85, 247, 0.8),
                0 0 20px rgba(168, 85, 247, 0.5),
                0 0 30px rgba(168, 85, 247, 0.3);
  }
}

/* 流光动画 */
@keyframes gradientFlow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* 光晕动画 */
@keyframes glowRotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* ========== 工具类 ========== */

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 渐变文字 */
.gradient-text {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 安全区域 */
.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 玻璃态效果 ========== */
.glass-card {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid var(--border-color);
  border-radius: 20px;
  box-shadow: var(--shadow-md);
}

.glass-modal {
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--border-color);
  border-radius: 24px;
  box-shadow: var(--shadow-lg);
}

/* ========== 霓虹发光效果 ========== */
.neon-purple {
  box-shadow: 0 0 10px rgba(124, 58, 237, 0.5),
              0 0 20px rgba(124, 58, 237, 0.3),
              0 0 30px rgba(124, 58, 237, 0.2);
}

.neon-blue {
  box-shadow: 0 0 10px rgba(0, 212, 255, 0.5),
              0 0 20px rgba(0, 212, 255, 0.3),
              0 0 30px rgba(0, 212, 255, 0.2);
}

.neon-text {
  text-shadow: 0 0 10px rgba(168, 85, 247, 0.8),
               0 0 20px rgba(168, 85, 247, 0.5),
               0 0 30px rgba(168, 85, 247, 0.3);
}

/* ========== 卡片基础样式 ========== */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  box-shadow: var(--shadow-sm);
}

.card:hover {
  border-color: var(--border-color-hover);
}

/* ========== 按钮基础样式 ========== */
.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: white;
  font-weight: 600;
  border-radius: 12px;
  box-shadow: 0 4px 16px rgba(124, 58, 237, 0.3);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2px 8px rgba(124, 58, 237, 0.2);
}

.btn-secondary {
  background: var(--bg-secondary);
  color: var(--text-primary);
  font-weight: 500;
  border-radius: 12px;
  border: 1px solid var(--border-color);
}

.btn-secondary:active {
  background: var(--bg-card-hover);
}

/* ========== 输入框基础样式 ========== */
.input-field {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 15px;
  color: var(--text-primary);
  transition: all 0.3s ease;
}

.input-field:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.2);
}

.input-field::placeholder {
  color: var(--text-hint);
}

/* ========== 标签样式 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  background: rgba(124, 58, 237, 0.15);
  border: 1px solid rgba(124, 58, 237, 0.3);
  border-radius: 6px;
  font-size: 12px;
  color: var(--primary-light);
}

/* ========== 页面过渡 ========== */
.page-enter {
  animation: fadeInUp 0.3s ease;
}

/* ========== 加载动画 ========== */
.loading-spinner {
  width: 20px;
  height: 20px;
  border: 2px solid rgba(124, 58, 237, 0.3);
  border-top-color: var(--primary-light);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

/* ========== 响应式字体 ========== */
@media (min-width: 375px) {
  page {
    font-size: 16px;
  }
}

@media (min-width: 414px) {
  page {
    font-size: 17px;
  }
}