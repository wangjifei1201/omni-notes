/* pages/groups/index.wxss - 分组管理页浅色简洁风格 */

.page-container {
  min-height: 100vh;
  position: relative;
  background: #f8f9fc;
}

/* ========== 顶部导航 ========== */
.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40px 16px 12px;
  background: #ffffff;
  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05);
}

.page-title {
  font-size: 18px;
  font-weight: 600;
  color: #1a1a2e;
}

.nav-left, .nav-right {
  width: 40px;
}

/* ========== 分组标签栏 ========== */
.group-tabs {
  position: fixed;
  top: 72px;
  left: 0;
  right: 0;
  z-index: 90;
  background: #ffffff;
  padding: 12px 0 8px;
  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05);
}

.tabs-scroll {
  white-space: nowrap;
}

.tabs-list {
  display: inline-flex;
  gap: 8px;
  padding: 0 16px;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 16px;
  background: #f8f9fc;
  border-radius: 20px;
  flex-shrink: 0;
}

.tab-item.active {
  background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 100%);
}

.tab-item.active .tab-name {
  color: #ffffff;
}

.tab-item.active .tab-count {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.tab-icon {
  font-size: 14px;
}

.tab-name {
  font-size: 14px;
  font-weight: 500;
  color: #6b6b7e;
}

.tab-count {
  font-size: 11px;
  font-weight: 600;
  color: #8b8b9e;
  background: rgba(124, 58, 237, 0.1);
  padding: 2px 8px;
  border-radius: 10px;
}

/* ========== 内容区 ========== */
.content-area {
  position: relative;
  z-index: 10;
  padding: 140px 16px 100px;
  height: 100vh;
  box-sizing: border-box;
}

/* ========== 任务列表 ========== */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.task-card {
  display: flex;
  gap: 12px;
  padding: 14px;
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.task-thumb {
  position: relative;
  width: 100px;
  height: 70px;
  border-radius: 12px;
  overflow: hidden;
  flex-shrink: 0;
  background: #f8f9fc;
}

.thumb-image {
  width: 100%;
  height: 100%;
}

.platform-badge {
  position: absolute;
  top: 6px;
  left: 6px;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 600;
  color: white;
}

.platform-badge.bilibili {
  background: #00A1D6;
}

.platform-badge.douyin {
  background: #FE2C55;
}

.task-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
}

.task-title {
  font-size: 15px;
  font-weight: 600;
  color: #1a1a2e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 8px;
}

.task-time {
  font-size: 12px;
  color: #8b8b9e;
}

.task-tags {
  display: flex;
  gap: 6px;
}

.tag {
  padding: 4px 8px;
  background: rgba(124, 58, 237, 0.1);
  border-radius: 6px;
  font-size: 11px;
  color: #7c3aed;
}

.task-actions {
  display: flex;
  align-items: flex-start;
  flex-shrink: 0;
}

.action-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #f8f9fc;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.action-btn:active {
  background: #f0f1f5;
}

.action-icon {
  font-size: 14px;
  color: #6b6b7e;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 20px;
}

.empty-icon-wrap {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: rgba(124, 58, 237, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}

.empty-icon {
  font-size: 36px;
}

.empty-title {
  font-size: 18px;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 14px;
  color: #8b8b9e;
  text-align: center;
}

/* ========== 底部留白 ========== */
.bottom-spacer {
  height: 20px;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 16px 20px calc(16px + env(safe-area-inset-bottom, 0px));
  background: #ffffff;
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.04);
}

.add-btn {
  width: 100%;
  height: 48px;
  background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 50%, #a855f7 100%);
  border-radius: 12px;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-shadow: 0 4px 14px rgba(124, 58, 237, 0.35);
}

.add-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2px 8px rgba(124, 58, 237, 0.25);
}

.add-icon {
  font-size: 20px;
  color: #ffffff;
  font-weight: 600;
}

.add-text {
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
}

/* ========== 弹窗 ========== */
.modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 88%;
  max-width: 320px;
  background: #ffffff;
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.modal-title {
  font-size: 18px;
  font-weight: 600;
  color: #1a1a2e;
}

.modal-close {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #f8f9fc;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  font-size: 14px;
  color: #6b6b7e;
}

.modal-close:active {
  background: #f0f1f5;
}

/* ========== 表单 ========== */
.form-group {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  font-size: 13px;
  font-weight: 500;
  color: #6b6b7e;
  margin-bottom: 8px;
}

.form-input {
  width: 100%;
  height: 48px;
  background: #f8f9fc;
  border: 1.5px solid transparent;
  border-radius: 12px;
  padding: 0 16px;
  font-size: 15px;
  color: #1a1a2e;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.form-input:focus {
  background: #ffffff;
  border-color: #7c3aed;
  box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.08);
}

/* ========== 弹窗按钮 ========== */
.modal-actions {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

.btn {
  flex: 1;
  height: 48px;
  border-radius: 12px;
  border: none;
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary {
  background: #f8f9fc;
  color: #6b6b7e;
}

.btn-secondary:active {
  background: #f0f1f5;
}

.btn-primary {
  background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 50%, #a855f7 100%);
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(124, 58, 237, 0.35);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2px 8px rgba(124, 58, 237, 0.25);
}

.btn-danger {
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(239, 68, 68, 0.35);
}

.btn-danger:active {
  transform: scale(0.98);
  box-shadow: 0 2px 8px rgba(239, 68, 68, 0.25);
}

/* ========== 删除确认弹窗 ========== */
.delete-modal {
  text-align: center;
}

.delete-desc {
  display: block;
  font-size: 14px;
  color: #6b6b7e;
  line-height: 1.5;
  margin-bottom: 8px;
}

/* ========== 移动到分组列表 ========== */
.move-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 300px;
  overflow-y: auto;
}

.move-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  background: #f8f9fc;
  border-radius: 12px;
}

.move-item:active {
  background: #f0f1f5;
}

.move-icon {
  font-size: 20px;
}

.move-name {
  flex: 1;
  font-size: 15px;
  font-weight: 500;
  color: #1a1a2e;
}

.move-count {
  font-size: 12px;
  color: #8b8b9e;
}