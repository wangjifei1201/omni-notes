<!--pages/auth/register/index.wxml-->
<view class="container">
  <view class="header">
    <button class="back-btn" bindtap="onBack">← 返回</button>
  </view>

  <view class="content">
    <view class="logo">🎬</view>
    <view class="title">Omni-Notes</view>
    <view class="subtitle">创建账户</view>

    <!-- 错误提示 -->
    <view class="error-message" wx:if="{{error}}">{{error}}</view>

    <!-- 表单 -->
    <view class="form">
      <view class="form-group">
        <view class="form-label">用户名</view>
        <input
          class="form-input"
          type="text"
          placeholder="请输入用户名"
          value="{{username}}"
          bindinput="onUsernameInput"
          placeholder-class="placeholder"
        />
      </view>

      <view class="form-group">
        <view class="form-label">邮箱</view>
        <input
          class="form-input"
          type="email"
          placeholder="请输入邮箱"
          value="{{email}}"
          bindinput="onEmailInput"
          placeholder-class="placeholder"
        />
      </view>

      <view class="form-group">
        <view class="form-label">密码</view>
        <view class="password-input-group">
          <input
            class="form-input"
            type="{{showPassword ? 'text' : 'password'}}"
            placeholder="请输入密码（至少6位）"
            value="{{password}}"
            bindinput="onPasswordInput"
            placeholder-class="placeholder"
          />
          <button class="toggle-password-btn" bindtap="onTogglePassword">
            {{showPassword ? '隐藏' : '显示'}}
          </button>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label">确认密码</view>
        <view class="password-input-group">
          <input
            class="form-input"
            type="{{showConfirmPassword ? 'text' : 'password'}}"
            placeholder="请再次输入密码"
            value="{{confirmPassword}}"
            bindinput="onConfirmPasswordInput"
            placeholder-class="placeholder"
          />
          <button class="toggle-password-btn" bindtap="onToggleConfirmPassword">
            {{showConfirmPassword ? '隐藏' : '显示'}}
          </button>
        </view>
      </view>

      <button
        class="btn btn-primary btn-large"
        bindtap="onRegister"
        disabled="{{isLoading}}"
        loading="{{isLoading}}"
      >
        {{isLoading ? '注册中...' : '注册'}}
      </button>
    </view>

    <!-- 登录链接 -->
    <view class="footer">
      <view class="footer-text">已有账户？</view>
      <button class="link-btn" bindtap="onNavigateToLogin">立即登录</button>
    </view>
  </view>
</view>
