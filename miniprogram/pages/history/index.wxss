/* pages/history/index.wxss - 历史记录页重构样式 */
/* 重点突出标题和摘要，辅助信息小字体灰色 */

.page-container {
  min-height: 100vh;
  position: relative;
  background: #f5f6fa;
}

/* ========== 顶部导航 ========== */
.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40px 16px 12px;
  background: #f5f6fa;
}

.nav-left, .nav-right {
  width: 40px;
}

.page-title {
  font-size: 18px;
  font-weight: 600;
  color: #1a1a2e;
}

/* ========== 搜索栏 ========== */
.search-section {
  position: fixed;
  top: 84px;
  left: 0;
  right: 0;
  z-index: 90;
  padding: 0 16px 12px;
  background: #f5f6fa;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #ffffff;
  border-radius: 12px;
  padding: 8px 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 16px;
  color: #999;
}

.search-input {
  flex: 1;
  height: 36px;
  font-size: 15px;
  color: #1a1a2e;
  background: transparent;
  border: none;
}

.search-placeholder {
  color: #bbb;
}

.clear-btn {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #f0f1f5;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.clear-icon {
  font-size: 12px;
  color: #999;
}

/* ========== 内容区 ========== */
.content-area {
  position: relative;
  z-index: 10;
  padding: 140px 16px 40px;
  height: 100vh;
  box-sizing: border-box;
}

/* ========== 历史列表 ========== */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.history-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 14px 16px;
  background: #ffffff;
  border-radius: 12px;
  position: relative;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
}

.history-card:active {
  background: #fafafa;
}

/* 第一行：标题 + 收藏 */
.card-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
}

.card-title {
  font-size: 16px;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.4;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 收藏按钮 */
.favorite-btn {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  flex-shrink: 0;
  margin-top: -2px;
}

.favorite-icon {
  font-size: 16px;
  color: #bbb;
  transition: color 0.2s ease;
}

.favorite-btn.active .favorite-icon {
  color: #f59e0b;
}

/* 第二行：分析摘要 + 状态 */
.card-summary-row {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  min-height: auto;
}

.summary-content {
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.summary-text {
  font-size: 13px;
  color: #666;
  line-height: 1.4;
}

/* 状态标签样式 */
.status-badge {
  display: flex;
  align-items: center;
  gap: 3px;
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.status-badge.completed {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
}

.status-badge.completed .status-icon {
  font-weight: 700;
}

.status-badge.failed {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}

.status-badge.failed .status-icon {
  font-weight: 700;
}

.status-badge.processing {
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
  animation: rotate 1.5s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.status-icon {
  display: inline-block;
  font-size: 10px;
  line-height: 1;
}

.status-text {
  font-size: 11px;
}

/* 第三行：视频元信息 + 更多 */
.card-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: 12px;
  color: #999;
}

.meta-content {
  display: flex;
  align-items: center;
  gap: 4px;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
  font-size: 12px;
  color: #999;
}

.meta-text {
  font-size: 12px;
  color: #999;
  display: inline;
}

.meta-sep {
  font-size: 12px;
  color: #ddd;
  margin: 0 2px;
  display: inline;
  flex-shrink: 0;
}

.meta-platform {
  font-size: 12px;
  color: #999;
  display: inline;
  font-weight: 500;
  flex-shrink: 0;
}

.meta-platform.bilibili {
  color: #00A1D6;
}

.meta-platform.douyin {
  color: #FE2C55;
}

.meta-time {
  font-size: 12px;
  color: #999;
  display: inline;
  flex-shrink: 0;
}

/* 更多操作按钮 */
.card-more-btn {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  flex-shrink: 0;
}

.more-icon {
  font-size: 14px;
  color: #bbb;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2px;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80px 20px;
}

.empty-icon-wrap {
  position: relative;
  width: 80px;
  height: 80px;
  margin-bottom: 20px;
}

.empty-glow {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 58, 237, 0.1) 0%, transparent 70%);
  filter: blur(15px);
}

.empty-icon {
  position: absolute;
  inset: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  color: rgba(124, 58, 237, 0.3);
}

.empty-title {
  font-size: 18px;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 14px;
  color: #999;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 24px;
}

.empty-action {
  padding: 12px 28px;
  background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
  border-radius: 12px;
  font-size: 15px;
  font-weight: 600;
  color: white;
  border: none;
  box-shadow: 0 4px 16px rgba(124, 58, 237, 0.25);
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px calc(16px + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.04);
}

.selection-count {
  font-size: 15px;
  font-weight: 600;
  color: #1a1a2e;
}

.selection-actions {
  display: flex;
  gap: 12px;
}

.action-btn.delete {
  background: rgba(239, 68, 68, 0.08);
}

.action-btn.delete .action-icon,
.action-btn.delete text {
  color: #ef4444;
}

/* ========== 操作菜单 ========== */
.action-sheet {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
}

.sheet-content {
  position: relative;
  background: #ffffff;
  border-radius: 20px 20px 0 0;
  padding: 20px 16px calc(20px + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-header {
  text-align: center;
  padding-bottom: 16px;
  margin-bottom: 12px;
}

.sheet-title {
  font-size: 15px;
  font-weight: 600;
  color: #999;
}

.sheet-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}

.sheet-btn {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px;
  background: #f8f9fc;
  border-radius: 12px;
  border: none;
}

.sheet-btn.delete {
  background: rgba(239, 68, 68, 0.08);
}

.btn-icon {
  font-size: 18px;
  color: #7c3aed;
}

.sheet-btn.delete .btn-icon {
  color: #ef4444;
}

.btn-text {
  font-size: 16px;
  color: #1a1a2e;
  font-weight: 500;
}

.sheet-btn.delete .btn-text {
  color: #ef4444;
}

.sheet-cancel {
  width: 100%;
  padding: 16px;
  background: #f0f1f5;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
  color: #666;
  border: none;
}