<!--pages/analysis/detail/index.wxml - 分析详情页-->
<view class="page-container">
  <!-- 顶部导航（无返回按钮，使用原生返回） -->
  <view class="nav-header">
    <view class="nav-left"></view>
    <text class="page-title">分析详情</text>
    <view class="nav-right"></view>
  </view>

  <!-- 内容区 -->
  <scroll-view class="content-area" scroll-y="true" enhanced="true" show-scrollbar="false">

    <!-- 品牌头部 -->
    <view class="brand-header">
      <view class="brand-logo">O</view>
      <view class="brand-info">
        <text class="brand-name">Omni-Notes</text>
        <text class="brand-slogan">AI 视频笔记</text>
      </view>
    </view>

    <!-- 分析中状态展示 -->
    <view class="processing-section" wx:if="{{task && task.status !== 'completed' && task.status !== 'failed'}}">
      <!-- 主标题 -->
      <view class="processing-header">
        <text class="processing-title">AI 正在分析视频...</text>
        <text class="processing-timer">{{elapsedTimeFormat}}</text>
        <text class="processing-step-name">{{currentStepName}}</text>
      </view>

      <!-- 视频卡片（分析中状态） -->
      <view class="video-card processing-card">
        <view class="video-thumb processing-thumb">
          <image class="thumb-image" src="{{analysis.video.thumbnail || '/images/default-thumb.png'}}" mode="aspectFill" />
          <view class="platform-badge {{analysis.video.platform}}">
            <text>{{analysis.video.platform === 'bilibili' ? 'B站' : '抖音'}}</text>
          </view>
          <view class="processing-overlay">
            <view class="processing-spinner">
              <view class="spinner-ring"></view>
              <view class="spinner-ring"></view>
              <view class="spinner-ring"></view>
            </view>
            <text class="processing-percent">{{overallProgress}}%</text>
          </view>
        </view>
        <view class="video-info">
          <text class="video-title">{{analysis.video.title || '视频分析中...'}}</text>
          <view class="video-meta">
            <text class="meta-status {{task.status}}">{{task.status_text || '准备中...'}}</text>
          </view>
        </view>
      </view>

      <!-- 进度条 -->
      <view class="progress-card">
        <view class="progress-header">
          <text class="progress-title">分析进度</text>
          <text class="progress-step">{{currentMessage}}</text>
        </view>
        <view class="progress-bar-wrap">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{overallProgress}}%"></view>
          </view>
        </view>
        <view class="progress-steps">
          <view class="step-item {{currentStep === 'extract' ? 'active' : (stepStatus.extract === 'completed' || stepStatus.extract === 'skipped' ? 'completed' : '')}}">
            <view class="step-dot">
              <text wx:if="{{stepStatus.extract === 'completed' || stepStatus.extract === 'skipped'}}" class="icon-check">✓</text>
              <text wx:elif="{{currentStep === 'extract'}}" class="icon-spin">◉</text>
              <text wx:else>1</text>
            </view>
            <text class="step-label">解析</text>
          </view>
          <view class="step-line {{stepStatus.extract === 'completed' || stepStatus.extract === 'skipped' ? 'completed' : ''}}"></view>
          <view class="step-item {{currentStep === 'download' ? 'active' : (stepStatus.download === 'completed' || stepStatus.download === 'skipped' ? 'completed' : '')}}">
            <view class="step-dot">
              <text wx:if="{{stepStatus.download === 'completed' || stepStatus.download === 'skipped'}}" class="icon-check">✓</text>
              <text wx:elif="{{currentStep === 'download'}}" class="icon-spin">◉</text>
              <text wx:else>2</text>
            </view>
            <text class="step-label">下载</text>
          </view>
          <view class="step-line {{stepStatus.download === 'completed' || stepStatus.download === 'skipped' ? 'completed' : ''}}"></view>
          <view class="step-item {{currentStep === 'transcribe' ? 'active' : (stepStatus.transcribe === 'completed' || stepStatus.transcribe === 'skipped' ? 'completed' : '')}}">
            <view class="step-dot">
              <text wx:if="{{stepStatus.transcribe === 'completed' || stepStatus.transcribe === 'skipped'}}" class="icon-check">✓</text>
              <text wx:elif="{{currentStep === 'transcribe'}}" class="icon-spin">◉</text>
              <text wx:else>3</text>
            </view>
            <text class="step-label">转写</text>
          </view>
          <view class="step-line {{stepStatus.transcribe === 'completed' || stepStatus.transcribe === 'skipped' ? 'completed' : ''}}"></view>
          <view class="step-item {{currentStep === 'analyze' ? 'active' : (stepStatus.analyze === 'completed' ? 'completed' : '')}}">
            <view class="step-dot">
              <text wx:if="{{stepStatus.analyze === 'completed'}}" class="icon-check">✓</text>
              <text wx:elif="{{currentStep === 'analyze'}}" class="icon-spin">◉</text>
              <text wx:else>4</text>
            </view>
            <text class="step-label">分析</text>
          </view>
        </view>
      </view>

      <!-- 步骤详情卡片 -->
      <view class="step-detail-card">
        <view class="step-detail-icon">
          <text wx:if="{{currentStep === 'extract'}}">◊</text>
          <text wx:elif="{{currentStep === 'download'}}">▼</text>
          <text wx:elif="{{currentStep === 'transcribe'}}">◐</text>
          <text wx:elif="{{currentStep === 'analyze'}}">◈</text>
          <text wx:else>◉</text>
        </view>
        <view class="step-detail-content">
          <text class="step-detail-title">{{currentMessage}}</text>
          <text class="step-detail-desc" wx:if="{{task.status === 'queued'}}">系统繁忙，请耐心等待</text>
          <text class="step-detail-desc" wx:elif="{{currentStep === 'extract'}}">正在获取视频信息和解码...</text>
          <text class="step-detail-desc" wx:elif="{{currentStep === 'download'}}">正在下载视频文件，请稍候...</text>
          <text class="step-detail-desc" wx:elif="{{currentStep === 'transcribe'}}">正在识别视频中的语音内容...</text>
          <text class="step-detail-desc" wx:elif="{{currentStep === 'analyze'}}">AI 正在分析内容并生成摘要...</text>
        </view>
      </view>

      <!-- 下载子进度 -->
      <view class="sub-progress-card" wx:if="{{currentStep === 'download' && downloadProgress}}">
        <view class="sub-progress-header">
          <text class="sub-progress-label">下载进度</text>
          <text class="sub-progress-percent">{{downloadProgress}}%</text>
        </view>
        <view class="sub-progress-bar">
          <view class="sub-progress-fill" style="width: {{downloadProgress}}%"></view>
        </view>
      </view>

      <!-- 转写子进度 -->
      <view class="sub-progress-card" wx:if="{{currentStep === 'transcribe' && transcribeProgress}}">
        <view class="sub-progress-header">
          <text class="sub-progress-label">转写进度</text>
          <text class="sub-progress-percent">{{transcribeProgress}}%</text>
        </view>
        <view class="sub-progress-bar">
          <view class="sub-progress-fill" style="width: {{transcribeProgress}}%"></view>
        </view>
      </view>
    </view>

    <!-- 分析完成/进行中状态 - 视频卡片（可左滑） -->
    <view class="video-card-wrapper" wx:if="{{task && (task.status === 'completed' || task.status === 'running' || task.status === 'queued')}}">
      <view class="video-card {{swipeClass}}" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
        <view class="card-content">
          <!-- 缩略图 -->
          <view class="video-thumb">
            <image class="thumb-image" src="{{analysis.video.thumbnail || '/images/default-thumb.png'}}" mode="aspectFill" />
            <view class="platform-badge {{analysis.video.platform}}">
              <text>{{analysis.video.platform === 'bilibili' ? 'B站' : '抖音'}}</text>
            </view>
            <view class="play-overlay" wx:if="{{analysis.video.url}}" bindtap="onPlayVideo">
              <view class="play-btn">
                <text class="play-icon">▶</text>
              </view>
            </view>
          </view>
          <!-- 视频信息 -->
          <view class="video-info">
            <text class="video-title">{{analysis.video.title || '未命名视频'}}</text>
            <view class="video-meta">
              <text class="meta-author" wx:if="{{analysis.video.author}}">{{analysis.video.author}}</text>
              <text class="meta-dot" wx:if="{{analysis.video.author}}">•</text>
              <text class="meta-time">{{analysis.created_at}}</text>
            </view>
          </view>
        </view>
        <!-- 左滑操作按钮（重新分析、删除） -->
        <view class="swipe-actions">
          <view class="swipe-btn reanalysis" bindtap="onReanalyze">
            <text>重新分析</text>
          </view>
          <view class="swipe-btn delete" bindtap="onDelete">
            <text>删除</text>
          </view>
        </view>
      </view>

      <!-- 分组标签（仅在有分组时显示） -->
      <view class="group-tag" wx:if="{{analysis.group_name}}">
        <text class="group-tag-text">{{analysis.group_name}}</text>
      </view>
    </view>

    <!-- Tab 内容区（分析完成后显示） -->
    <view class="tabs-section" wx:if="{{task && task.status === 'completed'}}">
      <!-- Tab头部：摘要、要点（含数量角标）、导图、字幕 -->
      <view class="tabs-header">
        <view
          class="tab-item {{activeTab === 'summary' ? 'active' : ''}}"
          data-tab="summary"
          bindtap="onTabChange"
        >
          <text class="tab-icon">◊</text>
          <text class="tab-text">摘要</text>
        </view>
        <view
          class="tab-item {{activeTab === 'keypoints' ? 'active' : ''}}"
          data-tab="keypoints"
          bindtap="onTabChange"
        >
          <text class="tab-icon">◉</text>
          <text class="tab-text">要点</text>
          <view class="tab-badge" wx:if="{{analysis.keypoints && analysis.keypoints.length > 0}}">
            <text>{{analysis.keypoints.length}}</text>
          </view>
        </view>
        <view
          class="tab-item {{activeTab === 'mindmap' ? 'active' : ''}}"
          data-tab="mindmap"
          bindtap="onTabChange"
        >
          <text class="tab-icon">◈</text>
          <text class="tab-text">导图</text>
        </view>
        <view
          class="tab-item {{activeTab === 'transcript' ? 'active' : ''}}"
          data-tab="transcript"
          bindtap="onTabChange"
        >
          <text class="tab-icon">◐</text>
          <text class="tab-text">字幕</text>
        </view>
      </view>

      <!-- 内容面板 -->
      <view class="tab-content">
        <!-- 摘要面板 -->
        <view class="content-panel" wx:if="{{activeTab === 'summary'}}">
          <view class="panel-header">
            <view class="panel-icon">
              <text>◊</text>
            </view>
            <text class="panel-title">视频摘要</text>
            <button class="copy-btn" bindtap="onCopySummary">
              <text class="copy-icon">◉</text>
              <text>复制</text>
            </button>
          </view>
          <view class="summary-content">
            <text class="summary-text" wx:if="{{analysis.summary}}">{{analysis.summary}}</text>
            <view class="empty-panel" wx:else>
              <text class="empty-icon">◊</text>
              <text class="empty-text">暂无摘要内容</text>
            </view>
          </view>
        </view>

        <!-- 要点面板 -->
        <view class="content-panel" wx:if="{{activeTab === 'keypoints'}}">
          <view class="panel-header">
            <view class="panel-icon">
              <text>◉</text>
            </view>
            <text class="panel-title">核心要点</text>
          </view>
          <view class="keypoints-list" wx:if="{{analysis.keypoints && analysis.keypoints.length > 0}}">
            <view class="keypoint-item" wx:for="{{analysis.keypoints}}" wx:key="index">
              <view class="point-marker">
                <text>{{index + 1}}</text>
              </view>
              <view class="point-content">
                <text class="point-title">{{item.title}}</text>
                <text class="point-desc" wx:if="{{item.description}}">{{item.description}}</text>
                <text class="point-time" wx:if="{{item.timestamp}}">{{item.timestamp}}</text>
              </view>
            </view>
          </view>
          <view class="empty-panel" wx:else>
            <text class="empty-icon">◉</text>
            <text class="empty-text">暂无要点内容</text>
          </view>
        </view>

        <!-- 思维导图面板 -->
        <view class="content-panel" wx:if="{{activeTab === 'mindmap'}}">
          <view class="panel-header">
            <view class="panel-icon">
              <text>◈</text>
            </view>
            <text class="panel-title">思维导图</text>
            <button class="expand-btn" bindtap="onExpandMindmap">
              <text>复制导图</text>
            </button>
          </view>
          <view class="mindmap-content" wx:if="{{analysis.mindmapTree}}">
            <view class="mindmap-canvas">
              <view class="mindmap-root-node">
                <text>{{analysis.mindmapTree.root}}</text>
              </view>
              <view class="mindmap-trunk"></view>
              <scroll-view class="mindmap-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
                <view class="mindmap-branches">
                  <view class="mindmap-branch-wrap" wx:for="{{analysis.mindmapTree.branches}}" wx:key="index">
                    <view class="branch-line"></view>
                    <view class="mindmap-branch">
                      <text class="branch-title">{{item.title}}</text>
                    </view>
                    <view class="branch-items" wx:if="{{item.items && item.items.length > 0}}">
                      <view class="item-line"></view>
                      <view class="branch-item" wx:for="{{item.items}}" wx:for-item="subItem" wx:for-index="subIndex" wx:key="*this">
                        <text class="item-text">{{subItem}}</text>
                      </view>
                    </view>
                  </view>
                </view>
              </scroll-view>
            </view>
          </view>
          <view class="empty-panel" wx:else>
            <text class="empty-icon">◈</text>
            <text class="empty-text">暂无思维导图</text>
          </view>
        </view>

        <!-- 字幕面板 -->
        <view class="content-panel" wx:if="{{activeTab === 'transcript'}}">
          <view class="panel-header">
            <view class="panel-icon">
              <text>◐</text>
            </view>
            <text class="panel-title">字幕内容</text>
            <button class="copy-btn" bindtap="onCopyTranscript">
              <text class="copy-icon">◉</text>
              <text>复制</text>
            </button>
          </view>
          <view class="transcript-content" wx:if="{{analysis.transcript}}">
            <view
              class="transcript-segment"
              wx:for="{{analysis.transcript.segments}}"
              wx:key="index"
              bindtap="onSeekToTime"
              data-time="{{item.start}}"
            >
              <text class="segment-time">{{item.start_time}}</text>
              <text class="segment-text">{{item.text}}</text>
            </view>
          </view>
          <view class="empty-panel" wx:else>
            <text class="empty-icon">◐</text>
            <text class="empty-text">暂无字幕内容</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-spacer"></view>
  </scroll-view>

</view>
