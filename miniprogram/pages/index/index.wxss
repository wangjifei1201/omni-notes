/* pages/index/index.wxss - Omni-Notes 首页（遵循设计原型）*/

/* ========== 页面基础 ========== */
.page-container {
  min-height: 100vh;
  max-width: 100vw;
  width: 100%;
  overflow-x: hidden;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ========== 品牌头部 - 固定置顶 ========== */
.brand-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  max-width: 100vw;
  width: 100%;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40px 24px 20px;
  background: #ffffff;
  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.brand-logo {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: linear-gradient(135deg, #1a1a2e 0%, #4a4a6a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

.brand-info {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 18px;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: -0.3px;
}

.brand-slogan {
  font-size: 12px;
  color: #8b8b9e;
}

/* ========== 主内容滚动区 ========== */
.main-scroll {
  flex: 1;
  padding: 110px 24px 140px;
  max-width: 100vw;
  width: 100%;
  box-sizing: border-box;
}

/* 输入区域 */
.input-section {
  padding: 32px 0 0;
}

.section-title {
  margin-bottom: 24px;
}

.main-title {
  display: block;
  font-size: 28px;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8px;
}

.sub-title {
  display: block;
  font-size: 14px;
  color: #8b8b9e;
}

/* URL 输入框 */
.url-input-wrap {
  margin-bottom: 16px;
}

.url-input-box {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #f8f9fc;
  border: 1.5px solid transparent;
  border-radius: 16px;
  padding: 6px 6px 6px 16px;
  transition: all 0.3s ease;
}

.url-input-box.focused {
  background: #ffffff;
  border-color: #7c3aed;
  box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.08);
}

.input-icon {
  font-size: 18px;
  color: #a0a0b0;
  flex-shrink: 0;
}

.url-input {
  flex: 1;
  height: 48px;
  font-size: 15px;
  color: #1a1a2e;
  background: transparent;
  border: none;
}

.input-placeholder {
  color: #a0a0b0;
}

/* 平台标签 */
.platform-tags {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
  max-width: 100%;
  box-sizing: border-box;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  background: #f8f9fc;
  border-radius: 20px;
  flex-shrink: 0;
}

.tag-item.bilibili {
  background: rgba(0, 161, 214, 0.08);
}

.tag-item.douyin {
  background: rgba(254, 44, 85, 0.08);
}

.tag-icon {
  font-size: 14px;
  font-weight: 700;
  color: #6b6b7e;
}

.tag-name {
  font-size: 13px;
  color: #6b6b7e;
}

/* 开始按钮 - 固定在底部 */
.start-btn {
  position: fixed;
  left: 24px;
  right: 24px;
  bottom: calc(60px + env(safe-area-inset-bottom, 0px));
  height: 44px;
  background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 50%, #a855f7 100%);
  border-radius: 10px;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  box-shadow: 0 4px 14px rgba(124, 58, 237, 0.35);
  z-index: 50;
}

.start-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.start-btn:not(.disabled):active {
  transform: scale(0.98);
  box-shadow: 0 2px 8px rgba(124, 58, 237, 0.25);
}

.start-btn:not(.disabled):active::before {
  left: 100%;
}

.start-btn.disabled {
  background: linear-gradient(135deg, #d1d5db 0%, #e5e7eb 100%);
  box-shadow: none;
}

.start-btn[disabled] {
  opacity: 0.7;
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.btn-icon {
  display: inline-block;
  font-size: 16px;
  color: #ffffff;
}

.btn-text {
  display: inline-block;
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.5px;
}

.btn-spinner {
  width: 18px;
  height: 18px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== 功能介绍 ========== */
.features-section {
  padding: 32px 0;
  border-top: 1px solid #f0f0f5;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.header-title {
  font-size: 18px;
  font-weight: 700;
  color: #1a1a2e;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  max-width: 100%;
  box-sizing: border-box;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px;
  background: #f8f9fc;
  border-radius: 14px;
  max-width: 100%;
  box-sizing: border-box;
}

.feature-icon {
  font-size: 24px;
  font-weight: 700;
  color: #7c3aed;
  flex-shrink: 0;
}

.feature-content {
  flex: 1;
}

.feature-title {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 4px;
}

.feature-desc {
  display: block;
  font-size: 12px;
  color: #8b8b9e;
  line-height: 1.4;
}

/* ========== 登录模态框 ========== */
.auth-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 100vw;
  width: 100%;
  box-sizing: border-box;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-card {
  position: relative;
  width: 88%;
  max-width: 320px;
  background: #ffffff;
  border-radius: 24px;
  padding: 36px 28px;
  text-align: center;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  box-sizing: border-box;
}

.modal-icon {
  width: 64px;
  height: 64px;
  border-radius: 18px;
  background: linear-gradient(135deg, #1a1a2e 0%, #4a4a6a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  font-size: 28px;
  font-weight: 700;
  color: white;
}

.modal-title {
  display: block;
  font-size: 22px;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 6px;
}

.modal-subtitle {
  display: block;
  font-size: 15px;
  font-weight: 600;
  color: #7c3aed;
  margin-bottom: 8px;
}

.modal-desc {
  display: block;
  font-size: 13px;
  color: #8b8b9e;
  margin-bottom: 28px;
  line-height: 1.5;
}

.wechat-login-btn {
  width: 100%;
  height: 52px;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-radius: 14px;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 12px;
  box-shadow: 0 4px 16px rgba(7, 193, 96, 0.2);
}

.wechat-login-btn:active {
  transform: scale(0.98);
}

.btn-icon-wechat {
  display: inline-block;
  font-size: 20px;
  color: #ffffff;
}

.btn-text-wechat {
  display: inline-block;
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
}

.guest-btn {
  width: 100%;
  height: 48px;
  background: #f8f9fc;
  border-radius: 14px;
  border: none;
  font-size: 14px;
  font-weight: 600;
  color: #6b6b7e;
}

.guest-btn:active {
  background: #f0f1f5;
}
