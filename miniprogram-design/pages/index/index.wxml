<!--pages/index/index.wxml - Omni-Notes 小程序首页-->
<view class="page-container">
  <!-- 动态背景 -->
  <view class="bg-layer">
    <view class="bg-gradient"></view>
    <view class="bg-orb orb-1"></view>
    <view class="bg-orb orb-2"></view>
    <view class="bg-grid"></view>
  </view>

  <!-- 顶部导航 -->
  <view class="nav-header">
    <view class="brand">
      <view class="logo">
        <view class="logo-icon">
          <text class="icon">✦</text>
        </view>
        <view class="logo-glow"></view>
      </view>
      <view class="brand-text">
        <text class="brand-name">Omni-Notes</text>
        <text class="brand-tagline">AI 视频分析</text>
      </view>
    </view>
    <view class="nav-actions">
      <button class="nav-btn" bindtap="onNavigateToHistory">
        <text class="nav-icon">◷</text>
      </button>
      <button class="nav-btn" bindtap="onNavigateToProfile">
        <text class="nav-icon">◉</text>
      </button>
    </view>
  </view>

  <!-- 主内容区 -->
  <scroll-view class="main-content" scroll-y="true" enhanced="true" show-scrollbar="false">
    <!-- 输入卡片 -->
    <view class="input-card">
      <view class="card-glow"></view>

      <!-- URL 输入 -->
      <view class="input-section">
        <view class="input-label">
          <text class="label-icon">◈</text>
          <text class="label-text">视频链接</text>
        </view>
        <view class="input-wrapper">
          <input
            class="url-input"
            type="text"
            placeholder="粘贴 B站、抖音链接..."
            value="{{videoUrl}}"
            bindinput="onUrlInput"
            placeholder-class="input-placeholder"
          />
          <button class="paste-btn" bindtap="onPasteUrl">
            <text class="paste-icon">▣</text>
          </button>
        </view>
        <view class="platform-hint">
          <view class="platform-tag">
            <text class="tag-dot" style="background: #00A1D6;"></text>
            <text class="tag-text">Bilibili</text>
          </view>
          <view class="platform-tag">
            <text class="tag-dot" style="background: #000000;"></text>
            <text class="tag-text">抖音</text>
          </view>
        </view>
      </view>

      <!-- 选项区 -->
      <view class="options-section">
        <view class="option-item" bindtap="onAnalysisTypeChange">
          <view class="option-icon-wrap">
            <text class="option-icon">⚡</text>
          </view>
          <view class="option-info">
            <text class="option-label">分析模式</text>
            <text class="option-value">{{analysisTypes[analysisTypeIndex].label}}</text>
          </view>
          <text class="option-arrow">›</text>
        </view>
        <view class="option-divider"></view>
        <view class="option-item" bindtap="onWhisperToggle">
          <view class="option-icon-wrap">
            <text class="option-icon">{{useWhisper ? '◐' : '◯'}}</text>
          </view>
          <view class="option-info">
            <text class="option-label">语音识别</text>
            <text class="option-value">{{useWhisper ? '高精度 (Whisper)' : '标准模式'}}</text>
          </view>
          <view class="toggle-switch {{useWhisper ? 'active' : ''}}">
            <view class="toggle-thumb"></view>
          </view>
        </view>
      </view>

      <!-- 开始按钮 -->
      <button
        class="start-btn {{isButtonDisabled || isAnalyzing ? 'disabled' : ''}}"
        bindtap="onSubmitAnalysis"
        disabled="{{isButtonDisabled || isAnalyzing}}"
      >
        <view class="btn-content">
          <block wx:if="{{isAnalyzing}}">
            <view class="btn-spinner">
              <view class="spinner-ring"></view>
            </view>
            <text class="btn-text">分析中...</text>
          </block>
          <block wx:else>
            <text class="btn-icon">▶</text>
            <text class="btn-text">开始分析</text>
          </block>
        </view>
        <view class="btn-shine" wx:if="{{!isButtonDisabled && !isAnalyzing}}"></view>
      </button>
    </view>

    <!-- 任务列表 -->
    <view class="tasks-section" wx:if="{{activeTasks.length > 0}}">
      <view class="section-header">
        <view class="section-title">
          <text class="title-icon">◈</text>
          <text class="title-text">分析任务</text>
        </view>
        <view class="task-count">{{activeTasks.length}}</view>
      </view>

      <view class="task-list">
        <view
          class="task-card {{item.status}}"
          wx:for="{{activeTasks}}"
          wx:key="taskId"
          data-taskid="{{item.taskId}}"
          bindtap="onTaskClick"
        >
          <!-- 状态指示器 -->
          <view class="task-status">
            <view class="status-ring {{item.status}}">
              <view class="status-dot"></view>
            </view>
            <view class="status-glow {{item.status}}"></view>
          </view>

          <!-- 任务信息 -->
          <view class="task-info">
            <view class="task-url">{{item.displayUrl || item.url}}</view>
            <view class="task-meta">
              <text class="meta-status {{item.status}}">
                {{item.status === 'completed' ? '已完成' : item.status === 'error' ? '失败' : '分析中'}}
              </text>
              <text class="meta-time">{{item.createdAt}}</text>
            </view>
            <!-- 进度条 -->
            <view class="progress-wrap" wx:if="{{item.status !== 'completed' && item.status !== 'error'}}">
              <view class="progress-track">
                <view class="progress-bar" style="width: {{item.progress}}%"></view>
                <view class="progress-shine"></view>
              </view>
              <text class="progress-text">{{item.progress}}%</text>
            </view>
          </view>

          <!-- 删除按钮 -->
          <button
            class="delete-btn"
            data-taskid="{{item.taskId}}"
            catchtap="onDeleteTask"
          >
            <text class="delete-icon">✕</text>
          </button>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{activeTasks.length === 0}}">
      <view class="empty-illustration">
        <view class="empty-glow"></view>
        <view class="empty-icon">
          <text>◈</text>
        </view>
      </view>
      <view class="empty-content">
        <text class="empty-title">准备好开始了吗？</text>
        <text class="empty-desc">粘贴视频链接，AI 将为你提取精华内容</text>
      </view>

      <!-- 功能特性 -->
      <view class="features-grid">
        <view class="feature-item">
          <view class="feature-icon-wrap">
            <text class="feature-icon">◊</text>
          </view>
          <text class="feature-name">智能摘要</text>
        </view>
        <view class="feature-item">
          <view class="feature-icon-wrap">
            <text class="feature-icon">◉</text>
          </view>
          <text class="feature-name">核心要点</text>
        </view>
        <view class="feature-item">
          <view class="feature-icon-wrap">
            <text class="feature-icon">◈</text>
          </view>
          <text class="feature-name">思维导图</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 登录模态框 -->
  <view class="auth-modal" wx:if="{{showAuthModal}}" bindtap="onCloseAuthModal">
    <view class="modal-backdrop"></view>
    <view class="modal-card" catchtap="preventBubble">
      <view class="modal-glow"></view>
      <view class="modal-icon">
        <text>◈</text>
      </view>
      <text class="modal-title">欢迎使用</text>
      <text class="modal-subtitle">Omni-Notes AI 视频分析</text>
      <text class="modal-desc">登录后可保存分析历史，随时随地查看</text>
      <button class="wechat-login-btn" bindtap="onLogin">
        <text class="btn-icon-wechat">◉</text>
        <text class="btn-text-wechat">微信一键登录</text>
      </button>
      <button class="guest-btn" bindtap="onGuestLogin">
        <text>游客模式</text>
      </button>
    </view>
  </view>
</view>
