/* pages/analysis/detail/index.wxss - 分析详情页样式（浅色主题） */

page {
  background: #ffffff;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.page-container {
  min-height: 100vh;
  position: relative;
  background: linear-gradient(180deg, #ffffff 0%, #f9fafb 100%);
}

/* 背景装饰层（浅色主题下隐藏） */
.bg-layer {
  display: none;
}

/* ========== 顶部导航 ========== */
.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50px 16px 12px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.95) 70%, transparent 100%);
  backdrop-filter: blur(20px);
}

.back-btn, .more-btn {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: #f3f4f6;
  border: 1px solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: all 0.2s ease;
}

.back-btn:active, .more-btn:active {
  background: #e5e7eb;
  transform: scale(0.95);
}

.back-icon {
  font-size: 24px;
  color: #374151;
  margin-top: -2px;
}

.more-icon {
  font-size: 18px;
  color: #6b7280;
}

.page-title {
  font-size: 18px;
  font-weight: 600;
  color: #1f2937;
}

/* ========== 内容区 ========== */
.content-area {
  position: relative;
  z-index: 10;
  padding: 110px 16px 100px;
  height: 100vh;
  box-sizing: border-box;
}

/* ========== 视频卡片 ========== */
.video-card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 20px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
}

.video-thumb {
  position: relative;
  width: 100%;
  height: 180px;
  background: #f3f4f6;
}

.thumb-image {
  width: 100%;
  height: 100%;
}

.platform-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
}

.platform-badge.bilibili {
  background: #00A1D6;
  color: white;
}

.platform-badge.douyin {
  background: #000000;
  color: white;
}

.play-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.play-overlay:active {
  background: rgba(0, 0, 0, 0.4);
}

.play-btn {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
}

.play-icon {
  font-size: 24px;
  color: #7c3aed;
  margin-left: 4px;
}

.video-info {
  padding: 16px;
}

.video-title {
  font-size: 16px;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.4;
  margin-bottom: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.video-meta {
  display: flex;
  align-items: center;
  gap: 8px;
}

.meta-author {
  font-size: 13px;
  color: #6b7280;
}

.meta-dot {
  font-size: 13px;
  color: #d1d5db;
}

.meta-time {
  font-size: 13px;
  color: #9ca3af;
}

/* ========== 标签切换 ========== */
.tabs-section {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
}

.tabs-header {
  display: flex;
  border-bottom: 1px solid #f3f4f6;
  padding: 4px;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 12px 4px;
  border-radius: 12px;
  transition: all 0.2s ease;
  position: relative;
}

.tab-item:active {
  background: #f9fafb;
}

.tab-item.active {
  background: rgba(124, 58, 237, 0.08);
}

.tab-icon {
  font-size: 18px;
  color: #9ca3af;
}

.tab-item.active .tab-icon {
  color: #7c3aed;
}

.tab-text {
  font-size: 12px;
  color: #9ca3af;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #7c3aed;
}

.tab-badge {
  position: absolute;
  top: 8px;
  right: 8px;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-badge text {
  font-size: 10px;
  font-weight: 600;
  color: white;
}

/* ========== 内容面板 ========== */
.tab-content {
  padding: 20px;
  min-height: 300px;
}

.content-panel {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.panel-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: rgba(124, 58, 237, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
}

.panel-icon text {
  font-size: 18px;
  color: #7c3aed;
}

.panel-title {
  flex: 1;
  font-size: 16px;
  font-weight: 600;
  color: #1f2937;
}

.copy-btn, .expand-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: #f3f4f6;
  border-radius: 10px;
  border: none;
  transition: all 0.2s ease;
}

.copy-btn:active, .expand-btn:active {
  background: #e5e7eb;
}

.copy-btn text, .expand-btn text {
  font-size: 13px;
  color: #6b7280;
}

.copy-icon {
  font-size: 14px;
}

/* 摘要内容 */
.summary-content {
  background: #f9fafb;
  border-radius: 16px;
  padding: 20px;
}

.summary-text {
  font-size: 15px;
  color: #374151;
  line-height: 1.7;
  white-space: pre-wrap;
  display: block;
}

/* 要点列表 */
.keypoints-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.keypoint-item {
  display: flex;
  gap: 14px;
  padding: 16px;
  background: #f9fafb;
  border-radius: 16px;
  border: 1px solid #f3f4f6;
}

.point-marker {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.point-marker text {
  font-size: 12px;
  font-weight: 700;
  color: white;
}

.point-content {
  flex: 1;
}

.point-title {
  font-size: 15px;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 6px;
  display: block;
  line-height: 1.4;
}

.point-desc {
  font-size: 13px;
  color: #6b7280;
  line-height: 1.5;
  margin-bottom: 8px;
  display: block;
}

.point-time {
  font-size: 12px;
  color: #7c3aed;
  font-weight: 500;
}

/* 思维导图 */
.mindmap-content {
  background: #f9fafb;
  border-radius: 16px;
  padding: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mindmap-image {
  width: 100%;
  border-radius: 12px;
}

/* 字幕内容 */
.transcript-content {
  background: #f9fafb;
  border-radius: 16px;
  padding: 16px;
}

.transcript-segment {
  display: flex;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #f3f4f6;
  transition: all 0.2s ease;
}

.transcript-segment:last-child {
  border-bottom: none;
}

.transcript-segment:active {
  background: #f3f4f6;
}

.segment-time {
  font-size: 12px;
  font-weight: 600;
  color: #7c3aed;
  flex-shrink: 0;
  min-width: 50px;
}

.segment-text {
  flex: 1;
  font-size: 14px;
  color: #4b5563;
  line-height: 1.5;
}

/* 空状态 */
.empty-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  background: #f9fafb;
  border-radius: 16px;
}

.empty-icon {
  font-size: 48px;
  color: rgba(124, 58, 237, 0.3);
  margin-bottom: 16px;
}

.empty-text {
  font-size: 14px;
  color: #9ca3af;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  gap: 12px;
  padding: 16px 20px calc(16px + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #e5e7eb;
  backdrop-filter: blur(20px);
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px;
  border-radius: 14px;
  border: none;
  transition: all 0.2s ease;
}

.action-btn.secondary {
  background: #f3f4f6;
}

.action-btn.secondary:active {
  background: #e5e7eb;
}

.action-btn.primary {
  background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
  box-shadow: 0 8px 20px rgba(124, 58, 237, 0.25);
}

.action-btn.primary:active {
  transform: scale(0.98);
  box-shadow: 0 4px 12px rgba(124, 58, 237, 0.2);
}

.btn-icon {
  font-size: 18px;
  color: #6b7280;
}

.action-btn.primary .btn-icon {
  color: white;
}

.btn-text {
  font-size: 15px;
  font-weight: 600;
  color: #374151;
}

.action-btn.primary .btn-text {
  color: white;
}

.bottom-spacer {
  height: 20px;
}

/* ========== 操作菜单 ========== */
.action-sheet {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
}

.sheet-content {
  position: relative;
  background: #ffffff;
  border-radius: 24px 24px 0 0;
  padding: 20px 16px calc(20px + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease;
  box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.1);
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-header {
  text-align: center;
  padding-bottom: 16px;
  border-bottom: 1px solid #f3f4f6;
  margin-bottom: 12px;
}

.sheet-title {
  font-size: 16px;
  font-weight: 600;
  color: #9ca3af;
}

.sheet-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}

.sheet-btn {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px;
  background: #f9fafb;
  border-radius: 14px;
  border: none;
  transition: all 0.2s ease;
}

.sheet-btn:active {
  background: #f3f4f6;
}

.sheet-btn.delete {
  background: rgba(239, 68, 68, 0.05);
}

.sheet-btn.delete:active {
  background: rgba(239, 68, 68, 0.1);
}

.sheet-btn .btn-icon {
  font-size: 20px;
  color: #7c3aed;
}

.sheet-btn.delete .btn-icon {
  color: #ef4444;
}

.sheet-btn .btn-text {
  font-size: 16px;
  color: #1f2937;
  font-weight: 500;
}

.sheet-btn.delete .btn-text {
  color: #dc2626;
}

.sheet-cancel {
  width: 100%;
  padding: 16px;
  background: #f3f4f6;
  border-radius: 14px;
  font-size: 16px;
  font-weight: 600;
  color: #374151;
  border: none;
  margin-top: 4px;
}
