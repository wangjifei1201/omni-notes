<!--pages/profile/index.wxml - 个人中心页-->
<view class="page-container">
  <!-- 背景 -->
  <view class="bg-layer">
    <view class="bg-gradient"></view>
    <view class="bg-orb orb-1"></view>
    <view class="bg-orb orb-2"></view>
  </view>

  <!-- 顶部导航 -->
  <view class="nav-header">
    <text class="page-title">我的</text>
    <button class="settings-btn" bindtap="onGoSettings">
      <text class="settings-icon">◈</text>
    </button>
  </view>

  <!-- 内容区 -->
  <scroll-view class="content-area" scroll-y="true" enhanced="true" show-scrollbar="false">
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <view class="card-glow"></view>
      <view class="user-main">
        <view class="avatar-wrap">
          <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
          <view class="avatar-ring"></view>
        </view>
        <view class="user-info">
          <text class="user-name">{{userInfo.nickName || '游客用户'}}</text>
          <view class="user-badge">
            <text class="badge-icon">◉</text>
            <text class="badge-text">{{userInfo.isVIP ? 'VIP会员' : '普通用户'}}</text>
          </view>
        </view>
      </view>

      <!-- 用户统计 -->
      <view class="user-stats">
        <view class="stat-item" bindtap="onGoHistory">
          <text class="stat-num">{{userStats.analysisCount}}</text>
          <text class="stat-label">分析次数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="onGoFavorites">
          <text class="stat-num">{{userStats.favoriteCount}}</text>
          <text class="stat-label">收藏</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{userStats.daysJoined}}</text>
          <text class="stat-label">使用天数</text>
        </view>
      </view>
    </view>

    <!-- AI 设置卡片 -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-icon">
          <text>◈</text>
        </view>
        <text class="section-title">AI 配置</text>
      </view>

      <view class="menu-list">
        <view class="menu-item" bindtap="onSelectModel">
          <view class="item-left">
            <view class="item-icon purple">
              <text>◉</text>
            </view>
            <view class="item-info">
              <text class="item-title">AI 模型</text>
              <text class="item-desc">{{aiConfig.model === 'tongyi' ? '通义千问' : 'OpenAI'}}</text>
            </view>
          </view>
          <view class="item-right">
            <text class="arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="onSetAPIKey">
          <view class="item-left">
            <view class="item-icon cyan">
              <text>◊</text>
            </view>
            <view class="item-info">
              <text class="item-title">API 密钥</text>
              <text class="item-desc">{{aiConfig.hasKey ? '已配置' : '未配置'}}</text>
            </view>
          </view>
          <view class="item-right">
            <text class="arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="onWhisperSettings">
          <view class="item-left">
            <view class="item-icon pink">
              <text>◐</text>
            </view>
            <view class="item-info">
              <text class="item-title">语音识别</text>
              <text class="item-desc">{{aiConfig.whisperEnabled ? '已启用' : '已禁用'}}</text>
            </view>
          </view>
          <view class="item-right">
            <view class="toggle {{aiConfig.whisperEnabled ? 'active' : ''}}">
              <view class="toggle-thumb"></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-icon">
          <text>◊</text>
        </view>
        <text class="section-title">功能</text>
      </view>

      <view class="menu-list">
        <view class="menu-item" bindtap="onGoGroups">
          <view class="item-left">
            <view class="item-icon blue">
              <text>◈</text>
            </view>
            <view class="item-info">
              <text class="item-title">分组管理</text>
              <text class="item-desc">管理视频分组</text>
            </view>
          </view>
          <view class="item-right">
            <text class="badge">{{groupCount}}</text>
            <text class="arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="onGoStorage">
          <view class="item-left">
            <view class="item-icon green">
              <text>◉</text>
            </view>
            <view class="item-info">
              <text class="item-title">存储空间</text>
              <text class="item-desc">{{storageInfo.used}} / {{storageInfo.total}}</text>
            </view>
          </view>
          <view class="item-right">
            <view class="storage-bar">
              <view class="storage-progress" style="width: {{storageInfo.percent}}%"></view>
            </view>
            <text class="arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="onExportData">
          <view class="item-left">
            <view class="item-icon orange">
              <text>◷</text>
            </view>
            <view class="item-info">
              <text class="item-title">导出数据</text>
              <text class="item-desc">导出分析记录</text>
            </view>
          </view>
          <view class="item-right">
            <text class="arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 关于与帮助 -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-icon">
          <text>◉</text>
        </view>
        <text class="section-title">关于</text>
      </view>

      <view class="menu-list">
        <view class="menu-item" bindtap="onGoHelp">
          <view class="item-left">
            <view class="item-icon gray">
              <text>?</text>
            </view>
            <view class="item-info">
              <text class="item-title">使用帮助</text>
            </view>
          </view>
          <view class="item-right">
            <text class="arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="onGoFeedback">
          <view class="item-left">
            <view class="item-icon gray">
              <text>◈</text>
            </view>
            <view class="item-info">
              <text class="item-title">意见反馈</text>
            </view>
          </view>
          <view class="item-right">
            <text class="arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="onGoAbout">
          <view class="item-left">
            <view class="item-icon gray">
              <text>◊</text>
            </view>
            <view class="item-info">
              <text class="item-title">关于 Omni-Notes</text>
              <text class="item-desc">v{{appVersion}}</text>
            </view>
          </view>
          <view class="item-right">
            <text class="arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-section" wx:if="{{isLoggedIn}}">
      <button class="logout-btn" bindtap="onLogout">
        <text>退出登录</text>
      </button>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- 模型选择弹窗 -->
  <view class="modal" wx:if="{{showModelModal}}">
    <view class="modal-backdrop" bindtap="onCloseModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">选择 AI 模型</text>
        <button class="modal-close" bindtap="onCloseModal">
          <text>✕</text>
        </button>
      </view>
      <view class="model-options">
        <view
          class="model-option {{aiConfig.model === 'tongyi' ? 'selected' : ''}}"
          data-model="tongyi"
          bindtap="onModelSelect"
        >
          <view class="option-info">
            <text class="option-name">通义千问</text>
            <text class="option-desc">阿里云大模型，中文理解能力强</text>
          </view>
          <view class="check-icon" wx:if="{{aiConfig.model === 'tongyi'}}">
            <text>✓</text>
          </view>
        </view>
        <view
          class="model-option {{aiConfig.model === 'openai' ? 'selected' : ''}}"
          data-model="openai"
          bindtap="onModelSelect"
        >
          <view class="option-info">
            <text class="option-name">OpenAI</text>
            <text class="option-desc">GPT 系列模型，需要配置 API Key</text>
          </view>
          <view class="check-icon" wx:if="{{aiConfig.model === 'openai'}}">
            <text>✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
