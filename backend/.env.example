# Omni-Notes Backend Environment Configuration

# Application
DEBUG=false
APP_NAME="Omni-Notes API"

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/omni_notes

# Security
COOKIE_ENCRYPTION_KEY=your-secret-key-must-be-32-bytes-long!
SESSION_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Configuration
AI_PROVIDER=bailian
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen-max

# Whisper Configuration
USE_WHISPER=true
WHISPER_MODEL=base

# Proxy Configuration
PROXY_ENABLED=false
PROXY_TYPE=direct
PROXY_URL=
PROXY_API_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# Queue Configuration
MAX_CONCURRENT_TASKS=2
MAX_QUEUE_SIZE=10

# Guest Mode
GUEST_USAGE_LIMIT=10
